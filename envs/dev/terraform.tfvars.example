# Copy to terraform.tfvars (git-ignored) and fill in.
project_id        = "my-project-id-dev"
region            = "asia-southeast2"
github_repository = "rakaprad/gcp-platform-terraform"

# Your public IP, e.g. from: curl -s https://checkip.amazonaws.com
master_authorized_networks = [
  { cidr_block = "203.0.113.10/32", display_name = "admin" },
]

# Optional: uncomment to create a monthly budget with alerts.
# billing_account_id = "012345-6789AB-CDEF01"
# budget_amount      = 100
# budget_currency    = "USD"
